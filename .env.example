# ==============================================================================
# TechyUpdates Tech Events Finder - Environment Variables
# ==============================================================================

# Google Gemini API Key (Required for AI categorization & enrichment)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Credentials (Required for channel broadcasts)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_COMMUNITY_CHANNEL_ID=@techy_hackathons_updates
# Alternatively, use numerical channel chat ID:
# TELEGRAM_COMMUNITY_CHANNEL_ID=-1001234567890

# Pipeline Security (Protects Serverless Trigger endpoints)
CRON_SECRET=your_super_secret_cron_token_here

# Pipeline Operational Settings
VERIFY_SSL=true
DRY_RUN=false
MAX_EVENTS_PER_SOURCE=35
REQUEST_TIMEOUT_SECONDS=15
